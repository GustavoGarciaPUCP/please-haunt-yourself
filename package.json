{
  "name": "please-haunt-yourself",
  "version": "0.1.0",
  "private": true,
  "description": "A haunted desktop experience built for Kiroween 2026",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check:windows": "node scripts/check-haunt-windows.mjs",
    "check:echo": "node scripts/check-echo-scene.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
